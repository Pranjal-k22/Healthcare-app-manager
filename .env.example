# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/healthcare_appointment_db

# Security & Authentication
JWT_SECRET=super_secret_healthcare_jwt_key_phase1_2026_change_in_production
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5173

# Initial Admin Seed Credentials
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@healthcare.com
ADMIN_PASSWORD=AdminPassword123!

# Email Notification Settings (Phase 5)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="HealthPulse <notifications@healthpulse.com>"
ENABLE_EMAIL_NOTIFICATIONS=false

# Background Job & Reminder Settings (Phase 5)
APPOINTMENT_REMINDER_MINUTES=60
REMINDER_JOB_INTERVAL_MS=60000

# Google Calendar OAuth Integration (Phase 6)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback
APPOINTMENT_TIMEZONE=UTC
