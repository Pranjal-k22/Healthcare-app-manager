# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/healthcare_appointment_db

# Security & Authentication
JWT_SECRET=your_super_secret_64_character_hex_jwt_key_here
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Initial Admin Seed Credentials
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@healthcare.com
ADMIN_PASSWORD=AdminPassword123!

# Email Notification Settings (Nodemailer + Gmail SMTP)
GMAIL_USER=your_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME="HealthPulse Hospital"
SUPPORT_EMAIL=your_address@gmail.com
ENABLE_EMAIL_NOTIFICATIONS=false

# Background Job & Reminder Settings
APPOINTMENT_REMINDER_MINUTES=60
REMINDER_JOB_INTERVAL_MS=60000

# Google Calendar OAuth Integration (Canonical Multi-User Route)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=your_google_oauth_state_signing_secret
TOKEN_ENCRYPTION_KEY=2e0f1ac01662063b65ed3d552ae04248a25dd7dd741ba97622e827cf2bf5a479
APPOINTMENT_TIMEZONE=UTC

# LLM Settings (Hybrid Dual-Engine: Local Ollama + Google Gemini Simultaneous Execution)
LLM_MODE=dual # 'dual' (runs Ollama & Gemini in parallel) or 'local-only' (runs Ollama only)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=28000
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_BASE_MS=300
GEMINI_API_KEY=your_google_gemini_api_key_here # Required only if LLM_MODE=dual
GEMINI_MODEL=gemini-3.5-flash-lite # Recommended for free-tier quotas (e.g. gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3.6-flash)
GEMINI_TIMEOUT_MS=20000

# Billing & Invoice Configuration
INVOICE_DUE_DAYS=14
